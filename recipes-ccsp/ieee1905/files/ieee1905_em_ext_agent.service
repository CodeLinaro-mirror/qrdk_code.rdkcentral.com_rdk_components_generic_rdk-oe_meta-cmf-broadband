[Unit]
Description=ieee1905 EasyMesh Remote Agent service
After=onewifi.service

[Service]
Type=forking
Environment="EM_LOG_PATH=/tmp/"
# To enable trace log:
# ``` /usr/bin/ieee1905 -f trace ```
# Other log levels can also be used ```debug,warn,error,info,off```
# Logging can be limited to certain modules for example to set trace level for topology manager and suppress all other logs:
# ```/usr/bin/ieee1905 -f ieee1905::topolgy_manager=trace```
# If needed certain module can be filtered out completly:
# ```/usr/bin/ieee1905 -f ieee1905=trace,ieee1905::ethernet_subject_reception=off```
# With above all ieee1905 modules will log with trace level and ethernet_subject_reception will not be visible in logs.
# Example of several modules logging:
# ```/usr/bin/ieee1905 -f ieee1905::al_sap=trace,ieee1905::cmdu_handler=trace,ieee1905::cmdu_proxy=trace,ieee1905::cmdu_observer=trace```
Environment="IEEE1905_LOG_LEVEL=off"
EnvironmentFile=/etc/device.properties
WorkingDirectory=/usr/ccsp/EasyMesh
# Allow change service env parameters in run-time
EnvironmentFile=-/nvram/easymesh.properties
ExecStartPre=/bin/sh -c '/usr/ccsp/EasyMesh/setup_ext_pre.sh'
ExecStartPre=/bin/sh -c 'if [ ! -e "/sys/class/net/eth1_virt_peer/address" ]; then /usr/ccsp/EasyMesh/setup_veth_for_em.sh brlan0 eth1 false; fi'
ExecStart=/bin/sh -c '/usr/bin/ieee1905 -f ${IEEE1905_LOG_LEVEL} -i eth1_virt_peer >> ${EM_LOG_PATH}/ieee1905_agent_log.txt &'
ExecStopPost=/bin/sh -c 'ip link del eth1_virt_end  2>/dev/null; echo "Cleaned eth1_virt_end"'
ExecStopPost=/bin/sh -c 'echo "`date`: Stopping/Restarting ieee1905_em_ext_agent.service" >> ${PROCESS_RESTART_LOG}'
Restart=always
LimitCORE=0


[Install]
WantedBy=multi-user.target
